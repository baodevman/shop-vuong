{
  "id": "product",
  "label": "Sản phẩm Quần Áo / Clothing Product",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug sản phẩm (Ví dụ: dam-ngan-linen-co-vuong)",
          "placeholder": "dam-ngan-linen-co-vuong"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "single": "heading1",
          "label": "Tên sản phẩm (Tiếng Việt)",
          "placeholder": "Đầm Ngắn Linen Trắng Cổ Vuông"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Danh mục",
          "options": [
            "dam-ngan",
            "dam-dai",
            "set-bo"
          ],
          "default_value": "dam-ngan"
        }
      },
      "price_vnd": {
        "type": "Number",
        "config": {
          "label": "Giá bán (VND) — Dùng khi hiển thị Tiếng Việt",
          "placeholder": "580000"
        }
      },
      "price_usd": {
        "type": "Number",
        "config": {
          "label": "Giá bán (USD) — Dùng khi hiển thị Tiếng Anh",
          "placeholder": "24"
        }
      },
      "original_price_vnd": {
        "type": "Number",
        "config": {
          "label": "Giá gốc so sánh (VND - tuỳ chọn khuyến mãi)",
          "placeholder": "690000"
        }
      },
      "original_price_usd": {
        "type": "Number",
        "config": {
          "label": "Giá gốc so sánh (USD - tuỳ chọn khuyến mãi)",
          "placeholder": "29"
        }
      },
      "badge": {
        "type": "Text",
        "config": {
          "label": "Nhãn nổi bật (Ví dụ: Mới, Bán chạy, Giảm giá...)",
          "placeholder": "Mới"
        }
      },
      "in_stock": {
        "type": "Boolean",
        "config": {
          "label": "Còn hàng",
          "default_value": true
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Ảnh chính (Tỉ lệ chuẩn 3:4 — Khuyên dùng 900x1200px hoặc 600x800px)",
          "constraint": {
            "width": 900,
            "height": 1200
          },
          "thumbnails": [
            {
              "name": "catalog",
              "width": 600,
              "height": 800
            }
          ]
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Bộ sưu tập ảnh chi tiết (Tỉ lệ chuẩn 3:4)",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Ảnh chi tiết (Tỉ lệ 3:4, khuyên dùng 900x1200px)",
                "constraint": {
                  "width": 900,
                  "height": 1200
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "multi": "paragraph, preformatted, strong, em, hyperlink, image, embed, list-item, o-list-item",
          "label": "Mô tả sản phẩm (Tiếng Việt)",
          "placeholder": "Mô tả chi tiết sản phẩm bằng tiếng Việt..."
        }
      }
    }
  }
}
