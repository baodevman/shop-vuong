{
  "id": "product",
  "label": "Sản phẩm Quần Áo / Clothing Product",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug",
          "placeholder": "dam-ngan-linen-co-vuong"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "single": "heading1",
          "label": "Tên sản phẩm",
          "placeholder": "Đầm Ngắn Linen Trắng Cổ Vuông"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Danh mục",
          "options": [
            "dam-ngan",
            "dam-dai",
            "set-bo"
          ],
          "default_value": "dam-ngan"
        }
      },
      "price_vnd": {
        "type": "Number",
        "config": {
          "label": "Giá bán (VND)",
          "placeholder": "580000"
        }
      },
      "price_usd": {
        "type": "Number",
        "config": {
          "label": "Giá bán (USD)",
          "placeholder": "24"
        }
      },
      "original_price_vnd": {
        "type": "Number",
        "config": {
          "label": "Giá gốc (VND - tuỳ chọn)",
          "placeholder": "690000"
        }
      },
      "original_price_usd": {
        "type": "Number",
        "config": {
          "label": "Giá gốc (USD - tuỳ chọn)",
          "placeholder": "29"
        }
      },
      "badge": {
        "type": "Text",
        "config": {
          "label": "Huy hiệu (Mới / Bán chạy)",
          "placeholder": "Mới"
        }
      },
      "colors": {
        "type": "Group",
        "config": {
          "label": "Phân loại màu sắc (Color Variations)",
          "fields": {
            "color_name": {
              "type": "Text",
              "config": {
                "label": "Tên màu",
                "placeholder": "Trắng, Đen, Be..."
              }
            },
            "color_code": {
              "type": "Color",
              "config": {
                "label": "Mã màu (Hex)"
              }
            },
            "color_image": {
              "type": "Image",
              "config": {
                "label": "Ảnh theo màu",
                "constraint": {
                  "width": 900,
                  "height": 1200
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "size_chart_image": {
        "type": "Image",
        "config": {
          "label": "Ảnh Bảng Size (Tiếng Việt)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "size_chart_image_en": {
        "type": "Image",
        "config": {
          "label": "Ảnh Bảng Size (Tiếng Anh - Tuỳ chọn)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "in_stock": {
        "type": "Boolean",
        "config": {
          "label": "Còn hàng",
          "default_value": true
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Ảnh đại diện (Tỉ lệ 3:4)",
          "constraint": {
            "width": 900,
            "height": 1200
          },
          "thumbnails": [
            {
              "name": "catalog",
              "width": 600,
              "height": 800
            }
          ]
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Album ảnh sản phẩm",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Ảnh chi tiết",
                "constraint": {
                  "width": 900,
                  "height": 1200
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "multi": "paragraph, preformatted, strong, em, hyperlink, image, embed, list-item, o-list-item",
          "label": "Mô tả sản phẩm",
          "placeholder": "Mô tả chi tiết sản phẩm bằng tiếng Việt..."
        }
      }
    }
  }
}
