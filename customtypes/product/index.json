{
  "id": "product",
  "label": "Sản phẩm Quần Áo / Clothing Product",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug sản phẩm (Ví dụ: dam-ngan-linen-co-vuong)",
          "placeholder": "dam-ngan-linen-co-vuong"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "single": "heading1",
          "label": "Tên sản phẩm (Tiếng Việt)",
          "placeholder": "Đầm Ngắn Linen Trắng Cổ Vuông"
        }
      },
      "title_en": {
        "type": "StructuredText",
        "config": {
          "single": "heading1",
          "label": "Tên sản phẩm (English)",
          "placeholder": "Square-Neck White Linen Mini Dress"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Danh mục",
          "options": [
            "dam-ngan",
            "dam-dai",
            "set-bo"
          ],
          "default_value": "dam-ngan"
        }
      },
      "price": {
        "type": "Number",
        "config": {
          "label": "Giá bán hiện tại (VND)",
          "placeholder": "580000"
        }
      },
      "original_price": {
        "type": "Number",
        "config": {
          "label": "Giá gốc so sánh (VND - tuỳ chọn có khuyến mãi)",
          "placeholder": "690000"
        }
      },
      "badge": {
        "type": "Text",
        "config": {
          "label": "Nhãn nổi bật (Mới / Bán chạy)",
          "placeholder": "Mới"
        }
      },
      "badge_en": {
        "type": "Text",
        "config": {
          "label": "Nhãn nổi bật (English - New / Best Seller)",
          "placeholder": "New"
        }
      },
      "in_stock": {
        "type": "Boolean",
        "config": {
          "label": "Còn hàng",
          "default_value": true
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Ảnh chính sản phẩm (Tỉ lệ chuẩn 3:4 — Khuyên dùng 900x1200px hoặc 600x800px)",
          "constraint": {
            "width": 900,
            "height": 1200
          },
          "thumbnails": [
            {
              "name": "catalog",
              "width": 600,
              "height": 800
            }
          ]
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Bộ sưu tập ảnh chi tiết (Tỉ lệ chuẩn 3:4 — Khuyên dùng 900x1200px)",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Ảnh chi tiết",
                "constraint": {
                  "width": 900,
                  "height": 1200
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "multi": "paragraph, preformatted, strong, em, hyperlink, image, embed, list-item, o-list-item",
          "label": "Mô tả sản phẩm (Tiếng Việt)",
          "placeholder": "Mô tả chi tiết sản phẩm..."
        }
      },
      "description_en": {
        "type": "StructuredText",
        "config": {
          "multi": "paragraph, preformatted, strong, em, hyperlink, image, embed, list-item, o-list-item",
          "label": "Mô tả sản phẩm (English)",
          "placeholder": "Detailed product description in English..."
        }
      }
    }
  }
}
